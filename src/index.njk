  const gio = new IntersectionObserver(es => {
    if (!es.some(e => e.isIntersecting)) return;
    $$('#gallery img').forEach(img => { img.loading = 'eager'; if (img.decode) img.decode().catch(() => {}); });
    gio.disconnect();
  }, { rootMargin: '1400px 0px' });
  gio.observe(gal);

  /* lightbox */
  const lb = $('#lb'), lbImg = $('#lbImg'), lbCount = $('#lbCount');
  let cur = 0;
  function show(i){
    cur = (i + PHOTOS.length) % PHOTOS.length;
    const ph = PHOTOS[cur];
    lbImg.style.animation = 'none'; void lbImg.offsetWidth; lbImg.style.animation = '';
    lbImg.src = ph.src; lbImg.alt = ph.alt;
    lbCount.textContent = `${cur + 1} / ${PHOTOS.length}`;
    const nx = new Image(); nx.src = PHOTOS[(cur + 1) % PHOTOS.length].src;
  }
  $$('.gcard').forEach(c => c.addEventListener('click', () => {
    const r = c.getBoundingClientRect();
    if (!reduce) emit(r.left + r.width / 2, r.top + r.height / 2, 24, true);
    show(+c.dataset.i);
    if (lb.showModal) lb.showModal(); else lb.setAttribute('open', '');
  }));
  $('.lb-prev').addEventListener('click', () => show(cur - 1));
  $('.lb-next').addEventListener('click', () => show(cur + 1));
  $('.lb-close').addEventListener('click', () => lb.close());
  lb.addEventListener('click', e => { if (e.target === lb) lb.close(); });
  lb.addEventListener('keydown', e => { if (e.key === 'ArrowLeft') show(cur - 1); if (e.key === 'ArrowRight') show(cur + 1); });
  let sx0 = null;
  lb.addEventListener('pointerdown', e => { sx0 = e.clientX; });
  lb.addEventListener('pointerup', e => { if (sx0 === null) return; const d = e.clientX - sx0; if (Math.abs(d) > 50) show(cur + (d < 0 ? 1 : -1)); sx0 = null; });

  /* ---------- boot ---------- */
  function resize(){ DPR = Math.min(devicePixelRatio || 1, 1.5); sizeStars(); sizeDust(); layoutGallery(); buildRoad(); }
  let rt; addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(resize, 120); });
  resize();
  const ro = new ResizeObserver(() => { clearTimeout(rt); rt = setTimeout(buildRoad, 120); });
  ro.observe(document.body);
  addEventListener('load', buildRoad);
  if (document.fonts) document.fonts.ready.then(buildRoad);
  requestAnimationFrame(frame);
})();
