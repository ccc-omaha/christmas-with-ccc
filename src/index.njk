<script>window.XMAS = {{ jsdata | jsonscript }};</script>
{% raw %}<script>
(() => {
  const $ = (s, r = document) => r.querySelector(s);
  const $$ = (s, r = document) => [...r.querySelectorAll(s)];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = matchMedia('(pointer: fine)').matches;
  const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
  const lerp = (a, b, t) => a + (b - a) * t;
  const smooth = t => { t = clamp(t, 0, 1); return t * t * (3 - 2 * t); };
  const store = {
    get(k){ try { return localStorage.getItem(k); } catch(e){ return null; } },
    set(k,v){ try { localStorage.setItem(k,v); } catch(e){} }
  };

  /* ---------- pointer ---------- */
  const ptr = { x: innerWidth/2, y: innerHeight/2, nx: 0, ny: 0, sx: 0, sy: 0 };
  addEventListener('pointermove', e => {
    ptr.x = e.clientX; ptr.y = e.clientY;
    ptr.nx = (e.clientX / innerWidth) * 2 - 1;
    ptr.ny = (e.clientY / innerHeight) * 2 - 1;
  }, { passive: true });

  /* ---------- starfield ---------- */
  const sc = $('#stars'), sx = sc.getContext('2d');
  let stars = [], DPR = Math.min(devicePixelRatio || 1, 1.5), shooting = null;
  function sizeStars(){
    sc.width = innerWidth * DPR; sc.height = innerHeight * DPR;
    const n = Math.min(innerWidth < 760 ? 110 : 200, Math.round(innerWidth * innerHeight / 7000));
    stars = Array.from({length: n}, () => ({
      x: Math.random(), y: Math.random(), r: Math.random() * 1.3 + .3,
      d: Math.random() * .9 + .1, p: Math.random() * Math.PI * 2, s: Math.random() * 1.5 + .5,
      g: Math.random() < .18
    }));
  }
  function drawStars(t){
    const w = sc.width, h = sc.height;
    sx.clearRect(0, 0, w, h);
    const sy = scrollY;
    for (const s of stars){
      const tw = reduce ? .8 : .55 + .45 * Math.sin(t * .001 * s.s + s.p);
      let y = (s.y * h - sy * DPR * s.d * .12) % h; if (y < 0) y += h;
      const x = s.x * w + ptr.sx * s.d * 14 * DPR;
      sx.globalAlpha = tw * (.35 + s.d * .6);
      sx.fillStyle = s.g ? '#f3d891' : '#fbefda';
      sx.beginPath(); sx.arc(x, y + ptr.sy * s.d * 10 * DPR, s.r * DPR, 0, 7); sx.fill();
    }
    if (!reduce){
      if (!shooting && Math.random() < .0025){
        shooting = { x: Math.random() * w * .7 + w * .15, y: Math.random() * h * .35, vx: (Math.random() < .5 ? -1 : 1) * 9 * DPR, vy: 4 * DPR, life: 1 };
      }
      if (shooting){
        const s = shooting;
        const g = sx.createLinearGradient(s.x, s.y, s.x - s.vx * 14, s.y - s.vy * 14);
        g.addColorStop(0, 'rgba(255,240,200,.9)'); g.addColorStop(1, 'rgba(255,240,200,0)');
        sx.globalAlpha = s.life; sx.strokeStyle = g; sx.lineWidth = 1.6 * DPR;
        sx.beginPath(); sx.moveTo(s.x, s.y); sx.lineTo(s.x - s.vx * 14, s.y - s.vy * 14); sx.stroke();
        s.x += s.vx; s.y += s.vy; s.life -= .018;
        if (s.life <= 0) shooting = null;
      }
    }
    sx.globalAlpha = 1;
  }

  /* ---------- stardust (pointer + touch) ---------- */
  const dc = $('#dust'), dx = dc.getContext('2d');
  let dust = [], last = null;
  function sizeDust(){ dc.width = innerWidth * DPR; dc.height = innerHeight * DPR; }
  function emit(x, y, n, burst){
    for (let i = 0; i < n; i++){
      const a = Math.random() * Math.PI * 2, sp = burst ? Math.random() * 3.2 + 1 : Math.random() * .6;
      dust.push({ x, y, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp - (burst ? .6 : .2), life: 1, r: Math.random() * (burst ? 3.2 : 2.2) + .8, star: Math.random() < (burst ? .5 : .25), c: Math.random() < .5 ? '#f3d891' : (Math.random() < .5 ? '#fbefda' : '#efa51a') });
    }
    if (dust.length > 360) dust.splice(0, dust.length - 360);
  }
  if (!reduce){
    addEventListener('pointermove', e => {
      if (last){ const d = Math.hypot(e.clientX - last.x, e.clientY - last.y); if (d < 9) return; }
      last = { x: e.clientX, y: e.clientY };
      emit(e.clientX, e.clientY, e.pointerType === 'touch' ? 2 : 1, false);
    }, { passive: true });
    addEventListener('pointerdown', e => {
      if (e.target.closest('a,button,input,textarea,summary,label')) return;
      emit(e.clientX, e.clientY, 18, true);
    }, { passive: true });
  }
  function sparkle(ctx, x, y, r){
    ctx.beginPath();
    ctx.moveTo(x, y - r * 2.4); ctx.quadraticCurveTo(x, y, x + r * 2.4, y);
    ctx.quadraticCurveTo(x, y, x, y + r * 2.4); ctx.quadraticCurveTo(x, y, x - r * 2.4, y);
    ctx.quadraticCurveTo(x, y, x, y - r * 2.4); ctx.fill();
  }
  let dustClear = true;
  function drawDust(){
    if (!dust.length){ if (!dustClear){ dx.clearRect(0, 0, dc.width, dc.height); dustClear = true; } return; }
    dustClear = false;
    dx.clearRect(0, 0, dc.width, dc.height);
    dx.globalCompositeOperation = 'lighter';
    for (const p of dust){
      p.x += p.vx; p.y += p.vy; p.vx *= .97; p.vy = p.vy * .97 + .015; p.life -= .016;
      dx.globalAlpha = Math.max(0, p.life);
      dx.fillStyle = p.c;
      const x = p.x * DPR, y = p.y * DPR, r = p.r * DPR * (.4 + p.life * .6);
      if (p.star) sparkle(dx, x, y, r); else { dx.beginPath(); dx.arc(x, y, r * .6, 0, 7); dx.fill(); }
    }
    dust = dust.filter(p => p.life > 0);
    dx.globalAlpha = 1; dx.globalCompositeOperation = 'source-over';
  }

  /* ---------- road ---------- */
  const road = $('#road'), svg = $('#roadSvg'), guide = $('#pathGuide'), rbs = $$('#ribbon .rb'), traveler = $('#traveler'), tInner = $('.inner', traveler);
  let LUT = [], total = 0, startY = 0, endY = 0, viewF = .55, curLen = 0, facing = 1, mobile = false;
  const docTop = el => el.getBoundingClientRect().top + scrollY;
  function buildRoad(){
    const W = document.documentElement.clientWidth;
    mobile = W < 760;
    road.style.height = '0px';
    const H = document.documentElement.scrollHeight;
    road.style.height = H + 'px';
    svg.setAttribute('width', W); svg.setAttribute('height', H); svg.setAttribute('viewBox', `0 0 ${W} ${H}`);

    const hero = $('#hero');
    const side = mobile ? .05 : Math.max(.05, Math.min(.12, ((W - 1120) / 2) / W * .55 + .04));
    const pts = [[mobile ? W * .5 : W * .3, docTop(hero) + hero.offsetHeight * .97]];
    $$('[data-way]').forEach((s, i) => {
      pts.push([i % 2 === 0 ? W * (1 - side) : W * side, docTop(s) + s.offsetHeight * .5]);
    });
    const m = $('#manger'), mr = m.getBoundingClientRect();
    const mTop = mr.top + scrollY;
    const end = [mr.left + mr.width * .5 - mr.width * (mobile ? .36 : .52), mTop + mr.height * .97];
    pts.push(end);

    let d = `M${pts[0][0].toFixed(1)} ${pts[0][1].toFixed(1)}`;
    for (let i = 1; i < pts.length; i++){
      const [x0, y0] = pts[i-1], [x1, y1] = pts[i], dy = y1 - y0;
      d += ` C${x0.toFixed(1)} ${(y0 + dy * .55).toFixed(1)} ${x1.toFixed(1)} ${(y1 - dy * .55).toFixed(1)} ${x1.toFixed(1)} ${y1.toFixed(1)}`;
    }
    guide.setAttribute('d', d);
    const k = mobile ? .55 : 1;
    rbs.forEach(p => { p.setAttribute('d', d); p.setAttribute('stroke-width', (+p.dataset.w) * k); });
    total = guide.getTotalLength();
    rbs.forEach(p => { p.style.strokeDasharray = `${total} ${total}`; });
    LUT = [];
    const N = 900;
    for (let i = 0; i <= N; i++){ const l = total * i / N, pt = guide.getPointAtLength(l); LUT.push([l, pt.x, pt.y]); }
    startY = pts[0][1]; endY = end[1];
    const vh = innerHeight, maxScroll = H - vh;
    viewF = clamp((endY - maxScroll) / vh, .3, .88);
    traveler.style.setProperty('--tw', (mobile ? 62 : 118) + 'px');
    measure();
  }
  function lenAtY(y){
    if (y <= LUT[0][2]) return 0;
    if (y >= LUT[LUT.length-1][2]) return total;
    let lo = 0, hi = LUT.length - 1;
