    put(beam, 'opacity', smooth((fin - .35) / .65).toFixed(3));

    updateGallery(sy, vh);
    if (!mobile || frameN % 2 === 0) drawStars(t);
    if (!reduce) drawDust();
    requestAnimationFrame(frame);
  }

  /* ---------- app store links by device ---------- */
  (() => {
    const ua = navigator.userAgent;
    const ios = /iPhone|iPad|iPod/i.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    const android = /Android/i.test(ua);
    const url = ios ? 'https://apps.apple.com/us/app/id459266558'
      : android ? 'https://play.google.com/store/apps/details?id=com.subsplash.thechurchapp.cccomaha'
      : null;
    if (url) $$('.app-link').forEach(a => { a.href = url; a.removeAttribute('target'); });
  })();

  /* ---------- plan-your-visit burst ---------- */
  if (!reduce){
    $$('[data-open-in-church-center-modal]').forEach(a => a.addEventListener('click', () => {
      const r = a.getBoundingClientRect(); emit(r.left + r.width / 2, r.top + r.height / 2, 26, true);
    }));
  }

  /* ---------- manger easter egg ---------- */
  const egg = $('#egg');
  if (egg) egg.addEventListener('click', e => {
    e.preventDefault();
    const r = egg.getBoundingClientRect();
    if (!reduce) emit(r.left + r.width / 2, r.top + r.height * .55, 40, true);
    setTimeout(() => { location.href = egg.getAttribute('href'); }, reduce ? 0 : 650);
  });

  /* ---------- reveals ---------- */
  const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px', threshold: .12 });
  $$('.reveal').forEach(el => io.observe(el));

  /* ---------- tilt cards ---------- */
  if (fine && !reduce){
    $$('.tilt').forEach(card => {
      card.addEventListener('pointermove', e => {
        const r = card.getBoundingClientRect(), px = (e.clientX - r.left) / r.width, py = (e.clientY - r.top) / r.height;
        card.style.transform = `rotateY(${(px - .5) * 6}deg) rotateX(${(.5 - py) * 5}deg)`;
        card.style.setProperty('--gx', px * 100 + '%'); card.style.setProperty('--gy', py * 100 + '%');
      });
      card.addEventListener('pointerleave', () => { card.style.transform = ''; });
    });
  }

  /* ---------- calendar ---------- */
  const LOC = 'Christ Community Church, 404 S 108th Ave, Omaha, NE 68154';
  const DESC = window.XMAS.calendarDescription;
  const addHour = s => {
    const d = new Date(Date.UTC(+s.slice(0,4), +s.slice(4,6) - 1, +s.slice(6,8), +s.slice(9,11) + 1, 0, 0));
    return d.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
  };
  $$('.cal .menu').forEach(menu => {
    const start = menu.dataset.start, end = addHour(start), label = menu.dataset.label;
    const title = `Christmas with CCC (${label})`;
    const g = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(title)}&dates=${start}/${end}&details=${encodeURIComponent(DESC)}&location=${encodeURIComponent(LOC)}`;
    menu.innerHTML = `<button type="button">Apple or Outlook (.ics)</button><a href="${g}" target="_blank" rel="noopener">Google Calendar</a>`;
    menu.querySelector('button').addEventListener('click', () => {
      const ics = ['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//Christ Community Church//Christmas//EN','BEGIN:VEVENT',
        `UID:${start}-christmaswithccc@cccomaha.org`, `DTSTAMP:${new Date().toISOString().replace(/[-:]/g,'').replace(/\.\d{3}/,'')}`,
        `DTSTART:${start}`, `DTEND:${end}`, `SUMMARY:${title}`, `DESCRIPTION:${DESC}`, `LOCATION:${LOC.replace(/,/g,'\\,')}`,
        'BEGIN:VALARM','TRIGGER:-PT2H','ACTION:DISPLAY','DESCRIPTION:Christmas with CCC','END:VALARM','END:VEVENT','END:VCALENDAR'].join('\r\n');
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([ics], { type: 'text/calendar' }));
      a.download = `christmas-with-ccc-${label.toLowerCase().replace(/[^a-z0-9]+/g,'-')}.ics`;
      document.body.appendChild(a); a.click(); a.remove();
      menu.closest('details').open = false;
    });
  });
  document.addEventListener('click', e => { $$('.cal[open]').forEach(d => { if (!d.contains(e.target)) d.open = false; }); });

  /* ---------- checklist + candle ---------- */
  $$('#checks input').forEach(cb => {
    cb.checked = store.get('ccc-x-' + cb.dataset.k) === '1';
    cb.addEventListener('change', () => store.set('ccc-x-' + cb.dataset.k, cb.checked ? '1' : '0'));
  });
  const candle = $('#candle'), candleCheck = $('#candleCheck');
  candle.addEventListener('click', e => {
    const lit = !candle.classList.contains('lit');
    candle.classList.toggle('lit', lit);
    candle.setAttribute('aria-pressed', String(lit));
    candle.setAttribute('aria-label', lit ? 'Blow out the candle' : 'Light the candle');
    if (lit){
      candleCheck.checked = true; store.set('ccc-x-candle', '1');
      if (!reduce){ const r = candle.getBoundingClientRect(); emit(r.left + r.width / 2, r.top + 20, 22, true); }
    }
  });

  /* ---------- invite ---------- */
  const msg = $('#msg'), chips = $$('#chips .chip'), toast = $('#toast');
  const URL_ = 'https://christmaswithccc.com';
  let edited = false, svc = window.XMAS.defaultService;
  const compose = () => window.XMAS.inviteMessage.split('{service}').join(svc).split('{link}').join(URL_);
  msg.value = compose();
  msg.addEventListener('input', () => { edited = true; });
  chips.forEach(c => c.addEventListener('click', () => {
    chips.forEach(x => x.setAttribute('aria-pressed', String(x === c)));
    const prev = svc; svc = c.dataset.s;
    msg.value = edited ? msg.value.replace(prev, svc) : compose();
    updateSms();
  }));
  const say = s => { toast.textContent = s; clearTimeout(say.t); say.t = setTimeout(() => toast.textContent = '', 2600); };
  const copy = async () => {
    try { await navigator.clipboard.writeText(msg.value); say('Copied. Paste it anywhere.'); }
    catch(e){ msg.select(); document.execCommand && document.execCommand('copy'); say('Copied.'); }
  };
  $('#copyBtn').addEventListener('click', copy);
  $('#shareBtn').addEventListener('click', async () => {
    if (navigator.share){ try { await navigator.share({ title: 'Christmas with CCC', text: msg.value }); } catch(e){} }
    else copy();
  });
  const sms = $('#smsBtn');
  function updateSms(){ sms.href = 'sms:?&body=' + encodeURIComponent(msg.value); }
  msg.addEventListener('input', updateSms); updateSms();

  /* ---------- gallery ---------- */
  const PHOTOS = window.XMAS.photos;
  const gal = $('#gallery'), gA = $('#gRowA'), gB = $('#gRowB');
  const pin = !reduce;
  if (!pin) document.body.classList.add('no-pin');
  let gTop = 0, gDist = 0, dA = 0, dB = 0, gSpan = 1, gk = -1, gLastA = "", gLastB = "";
  $$('.gcard').forEach((c, i) => c.style.setProperty('--rot', (i % 2 ? 1 : -1) * (0.6 + (i % 3) * 0.4) + 'deg'));
  function layoutGallery(){
