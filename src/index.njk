        const [p0, c0] = skyStops[i-1], [p1, c1] = skyStops[i], t = (p - p0) / (p1 - p0);
        return `rgb(${c0.map((c, j) => Math.round(lerp(c, c1[j], t))).join(',')})`;
      }
    }
    return 'rgb(34,10,30)';
  }
  const storyLines = $$('#storyLines p:not(.verse)');
  const star = { x: 0, y: 0, s: 1, init: false };

  const M = { H: 1, story: [], mTop: 0, mLeft: 0, mW: 0, mH: 0, tw: 118, th: 120 };
  function measure(){
    M.H = document.documentElement.scrollHeight;
    M.story = storyLines.map(el => el.getBoundingClientRect().top + scrollY);
    const r = $('#manger').getBoundingClientRect();
    M.mTop = r.top + scrollY; M.mLeft = r.left; M.mW = r.width; M.mH = r.height;
    M.tw = traveler.offsetWidth; M.th = traveler.offsetHeight;
  }
  function pointAt(l){
    if (!LUT.length) return { x: 0, y: 0 };
    const f = clamp(l / (total || 1), 0, 1) * (LUT.length - 1), i = Math.floor(f), j = Math.min(LUT.length - 1, i + 1), t = f - i;
    return { x: lerp(LUT[i][1], LUT[j][1], t), y: lerp(LUT[i][2], LUT[j][2], t) };
  }
  const W8 = new WeakMap();
  const put = (el, prop, v) => { let o = W8.get(el); if (!o){ o = {}; W8.set(el, o); } if (o[prop] !== v){ o[prop] = v; el.style[prop] = v; } };
  const putVar = (el, k, v) => { let o = W8.get(el); if (!o){ o = {}; W8.set(el, o); } if (o[k] !== v){ o[k] = v; el.style.setProperty(k, v); } };
  let lastDash = -1, frameN = 0, navOn = null;

  function frame(t){
    frameN++;
    const vh = innerHeight, W = innerWidth, sy = scrollY;
    const maxScroll = Math.max(1, M.H - vh);
    const p = clamp(sy / maxScroll, 0, 1);
    ptr.sx = lerp(ptr.sx, ptr.nx, .06); ptr.sy = lerp(ptr.sy, ptr.ny, .06);

    const on = sy > 40; if (on !== navOn){ nav.classList.toggle('scrolled', on); navOn = on; }
    put(sky, 'backgroundColor', skyColor(p));
    putVar(sky, '--satin', (1 - smooth(sy / vh)).toFixed(2));

    // hero parallax
    if (sy < vh * 1.4){
      const hp = sy / vh;
      const tilt = reduce || !fine ? 0 : 1;
      put(magiWrap, 'transform', `translate3d(${(ptr.sx * -16 * tilt).toFixed(1)}px, ${(sy * .28 + ptr.sy * -10 * tilt).toFixed(1)}px, 0) scale(${(1 + hp * .06).toFixed(4)})`);
      put(magiWrap, 'opacity', (1 - smooth(hp * 1.1)).toFixed(3));
      put(heroCopy, 'transform', `translate3d(${(ptr.sx * 10 * tilt).toFixed(1)}px, ${(sy * -.12 + ptr.sy * 6 * tilt).toFixed(1)}px, 0)`);
      put(heroCopy, 'opacity', (1 - smooth(hp * 1.3)).toFixed(3));
    }

    // story scrub
    storyLines.forEach((el, i) => {
      const top = M.story[i] - sy;
      put(el, 'opacity', reduce ? '1' : (.12 + .88 * smooth((vh * .82 - top) / (vh * .3))).toFixed(3));
    });

    // traveler
    let ahead = null;
    if (LUT.length){
      const targetY = clamp(sy + vh * viewF, startY, endY);
      const target = lenAtY(targetY);
      curLen = reduce ? target : lerp(curLen, target, .14);
      if (Math.abs(curLen - target) < .05) curLen = target;
      const pt = pointAt(curLen), pb = pointAt(Math.max(0, curLen - 6));
      ahead = pointAt(Math.min(total, curLen + total * .035));
      const dxv = pt.x - pb.x;
      if (Math.abs(dxv) > .4) facing = dxv >= 0 ? 1 : -1;
      if (curLen >= total - 2) facing = 1;
      const bob = reduce ? 0 : Math.sin(curLen * .06) * 2.2;
      put(traveler, 'transform', `translate3d(${(pt.x - M.tw / 2).toFixed(1)}px, ${(pt.y - M.th * .93 + bob).toFixed(1)}px, 0)`);
      put(tInner, 'transform', `scaleX(${facing})`);
