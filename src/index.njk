  /* ---------- hero, star, sky ---------- */
  const magiWrap = $('#magiWrap'), heroCopy = $('#heroCopy'), gs = $('#guide-star'), sky = $('#sky'), glow = $('.glow', sky), beam = $('#beam'), nav = $('#nav');
  const skyStops = [[0, [57,0,37]], [.3, [36,6,52]], [.62, [8,9,48]], [.86, [20,8,42]], [1, [34,10,30]]];
  function skyColor(p){
    for (let i = 1; i < skyStops.length; i++){
