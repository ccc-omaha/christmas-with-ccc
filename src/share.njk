<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ settings.seoTitle }}</title>
<meta name="description" content="{{ settings.seoDescription }}">
<meta name="robots" content="noindex, follow">
<meta property="og:type" content="website">
<meta property="og:url" content="https://christmaswithccc.com/share/">
<meta property="og:site_name" content="Christ Community Church">
<meta property="og:title" content="{{ settings.seoTitle }}">
<meta property="og:description" content="{{ settings.shareDescription }}">
<meta property="og:image" content="{{ site.url }}{{ settings.shareImageWide }}">
<meta property="og:image:secure_url" content="{{ site.url }}{{ settings.shareImageWide }}">
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="{{ shareWide.width }}">
<meta property="og:image:height" content="{{ shareWide.height }}">
<meta property="og:image:alt" content="{{ settings.shareImageWideAlt }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ site.url }}{{ settings.shareImageWide }}">
{% raw %}<style>body{margin:0;min-height:100vh;display:grid;place-items:center;background:#390025;color:#fbefda;font-family:system-ui,sans-serif}a{color:#e8c87a}</style>{% endraw %}
<script>location.replace('/' + location.search + location.hash);</script>
</head>
<body><p>Taking you to <a href="/">christmaswithccc.com</a></p></body>
</html>
